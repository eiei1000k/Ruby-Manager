{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ruby Manager",
  "version": "0.2.0",
  "identifier": "dev.eiei1000k.rubymanager",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage", "deb"],
    "category": "DeveloperTool",
    "shortDescription": "Ruby バージョンと Bundler の管理",
    "copyright": "© eiei1000k",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "languages": ["Japanese", "English"]
      }
    }
  }
}
